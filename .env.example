# 复制为 .env 后按需修改；docker compose 自动读取同目录 .env

# 预置密钥（可选）。留空 = 首次启动自动生成，从日志里搜 AGENTMEMORY_SECRET= 获取。
# 也可手动生成: openssl rand -hex 32
AGENTMEMORY_SECRET=

# LLM 能力（可选，全部留空则 keyless：BM25 关键词检索，无 LLM 压缩/摘要）
#ANTHROPIC_API_KEY=
#OPENROUTER_API_KEY=

# 本地嵌入（可选，设为 local 开启免费设备端语义检索）
#EMBEDDING_PROVIDER=local
